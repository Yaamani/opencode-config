{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "todowrite": "allow",
    "edit": "allow",
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "cd*": "allow",
      "pwd*": "allow",
      "dir*": "allow",
      "Get-ChildItem*": "allow",
      "Get-Location*": "allow",
      "Set-Location*": "allow",
      "Test-Path*": "allow",
      "echo*": "allow"
    }
  },
  "provider": {
    "openrouter": {
      "models": {
        "z-ai/glm-5.2": {
          "options": {
            "provider": {
              "only":  ["decart", "streamlake", "novita", "baidu", "deepinfra", "coreweave", "alibaba", "siliconflow", "gmicloud"],
              "allow_fallbacks": false
            }
          }
        },
        "deepseek/deepseek-v4-pro": {
          "options": {
            "provider": {
              "only":  ["baidu", "streamlake", "novita", "gmicloud", "deepinfra"],
              "allow_fallbacks": false
            }
          }
        }
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    }
  }
}
