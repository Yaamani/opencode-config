{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "todowrite": "allow",
    "edit": "allow",
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "cd*": "allow",
      "pwd*": "allow",
      "dir*": "allow",
      "Get-ChildItem*": "allow",
      "Get-Location*": "allow",
      "Set-Location*": "allow",
      "Get-Content*": "allow",
      "Test-Path*": "allow",
      "echo*": "allow",
      "cat*": "allow",
      "rg*": "allow",
      "git log*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git ls-files*": "allow",
      "pnpm test*": "allow",
      "pnpm build*": "allow",
      "pnpm exec prettier*": "allow",
      "pnpm exec eslint*": "allow",
      "pnpm exec vitest*": "allow",
      "pnpm exec tsc*": "allow",
    }
  },
  "provider": {
    "openrouter": {
      "models": {
        "z-ai/glm-5.2": {
          "options": {
            "provider": {
              "only":  ["decart", "streamlake", "novita", "baidu", "deepinfra", "coreweave", "alibaba", "siliconflow", "gmicloud"],
              "allow_fallbacks": false
            }
          }
        },
        "deepseek/deepseek-v4-pro": {
          "options": {
            "provider": {
              "only":  ["baidu", "streamlake", "novita", "gmicloud", "deepinfra"],
              "allow_fallbacks": false
            }
          }
        }
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    },
    "redmine": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "mcp-redmine==2026.08.01.002543",
        "--refresh-package",
        "mcp-redmine",
        "mcp-redmine"
      ],
      "enabled": false,
      "environment": {
        "REDMINE_URL": "{env:REDMINE_URL}",
        "REDMINE_API_KEY": "{env:REDMINE_API_KEY}",
      }
    }
  }
}
